# =============================================================================
# AnvilOps Platform — Dev / Demo Environment (~$305/month)
# =============================================================================
# Smallest reasonable instance sizes for development, demos, and testing.
# NOT suitable for production workloads.
#
# Usage:
#   cp terraform.dev.tfvars.example terraform.dev.tfvars
#   # Edit terraform.dev.tfvars with your values
#   terraform plan -var-file terraform.dev.tfvars -out tfplan
#   terraform apply tfplan
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

project_name     = "anvilops"
environment      = "dev"
aws_region       = "us-east-1"
secondary_region = "us-west-2"

tags = {
  Team        = "Platform Engineering"
  CostCenter  = "INFRA-001"
  Environment = "dev"
}

# -----------------------------------------------------------------------------
# DNS — Set your domain and optionally reuse an existing Route 53 hosted zone
# -----------------------------------------------------------------------------

domain_name              = "anvilops.example.com"
existing_route53_zone_id = ""  # e.g., "Z0123456789ABCDEFGHIJ"

# -----------------------------------------------------------------------------
# Networking — Single NAT Gateway saves ~$67/month
# -----------------------------------------------------------------------------

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
single_nat_gateway = true

# -----------------------------------------------------------------------------
# EKS Cluster — t3.medium nodes, minimal count
# Production: 3x t3.xlarge (~$450/mo) → Dev: 2x t3.medium (~$100/mo)
# -----------------------------------------------------------------------------

eks_node_instance_types    = ["t3.medium"]
eks_node_min_size          = 1
eks_node_max_size          = 3
eks_node_desired_size      = 2
# Public API endpoint — set to true for local kubectl access.
# Restrict to your IP for security (run: curl -s ifconfig.me)
eks_enable_public_endpoint = true
eks_public_access_cidrs    = ["0.0.0.0/0"]  # e.g., ["203.0.113.42/32"]

# -----------------------------------------------------------------------------
# RDS PostgreSQL — Smallest instance, no Multi-AZ, minimal storage
# Production: db.t3.large Multi-AZ (~$280/mo) → Dev: db.t3.micro (~$15/mo)
# -----------------------------------------------------------------------------

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "anvilops"

# -----------------------------------------------------------------------------
# ElastiCache Redis — Single micro node, no replication
# Production: cache.t3.medium x2 (~$130/mo) → Dev: cache.t3.micro x1 (~$15/mo)
# -----------------------------------------------------------------------------

redis_node_type          = "cache.t3.micro"
redis_num_cache_clusters = 1

# -----------------------------------------------------------------------------
# Cognito — MFA optional for dev workflow convenience
# -----------------------------------------------------------------------------

cognito_mfa_configuration = "OPTIONAL"

cognito_callback_urls = [
  "https://anvilops.example.com/api/auth/callback",
  "http://localhost:3000/api/auth/callback"
]

cognito_logout_urls = [
  "https://anvilops.example.com",
  "http://localhost:3000"
]

# -----------------------------------------------------------------------------
# Security — WAF disabled, no deletion protection
# -----------------------------------------------------------------------------

enable_waf                 = false
enable_deletion_protection = false

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

alert_email = "platform-team@example.com"

# -----------------------------------------------------------------------------
# Puppet Enterprise — Smaller instance for demo (10-node trial)
# Production: r5.xlarge (~$200/mo) → Dev: t3.medium (~$30/mo)
# -----------------------------------------------------------------------------

puppet_instance_type = "t3.medium"
# puppet_ami_id      = ""  # Leave unset to auto-discover latest Amazon Linux 2023
