{
  "_comment": "Example policy for reference only. The actual bucket policy is managed by Terraform in modules/state-backend/main.tf using dynamic resource ARNs.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforceSSLOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::anvilops-terraform-state-dev-PLACEHOLDER_ACCOUNT_ID",
        "arn:aws:s3:::anvilops-terraform-state-dev-PLACEHOLDER_ACCOUNT_ID/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
