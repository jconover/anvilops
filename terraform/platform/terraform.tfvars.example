# =============================================================================
# AnvilOps Platform Infrastructure - Example Variable Values
# =============================================================================
# Copy this file to terraform.tfvars and fill in values for your environment.
# Do NOT commit terraform.tfvars to version control.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init -backend-config="bucket=anvilops-terraform-state-dev-ACCOUNT_ID" \
#                  -backend-config="key=platform/terraform.tfstate" \
#                  -backend-config="region=us-east-1" \
#                  -backend-config="dynamodb_table=anvilops-terraform-locks-dev" \
#                  -backend-config="encrypt=true"
#   terraform plan
#   terraform apply
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

project_name     = "anvilops"
environment      = "dev"
aws_region       = "us-east-1"
secondary_region = "us-west-2"

tags = {
  Team       = "Platform Engineering"
  CostCenter = "INFRA-001"
}

# -----------------------------------------------------------------------------
# DNS
# If you have an existing Route 53 hosted zone, set existing_route53_zone_id
# to add records to it instead of creating a new zone.
# -----------------------------------------------------------------------------

domain_name              = "anvilops.example.com"
existing_route53_zone_id = ""  # e.g., "Z0123456789ABCDEFGHIJ"

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# -----------------------------------------------------------------------------
# EKS Cluster
# -----------------------------------------------------------------------------

eks_node_instance_types = ["t3.xlarge"]
eks_node_min_size       = 2
eks_node_max_size       = 6
eks_node_desired_size   = 3

# -----------------------------------------------------------------------------
# RDS PostgreSQL
# -----------------------------------------------------------------------------

db_instance_class    = "db.t3.large"
db_allocated_storage = 50
db_name              = "anvilops"

# -----------------------------------------------------------------------------
# ElastiCache Redis
# -----------------------------------------------------------------------------

redis_node_type          = "cache.t3.medium"
redis_num_cache_clusters = 2

# -----------------------------------------------------------------------------
# Cognito — MFA enforced by default; set to OPTIONAL only for dev
# -----------------------------------------------------------------------------

cognito_mfa_configuration = "ON"

cognito_callback_urls = [
  "https://anvilops.example.com/api/auth/callback",
  "http://localhost:3000/api/auth/callback"
]

cognito_logout_urls = [
  "https://anvilops.example.com",
  "http://localhost:3000"
]

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

enable_waf                 = true
enable_deletion_protection = false  # Set true for production

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

alert_email = "platform-team@example.com"

# -----------------------------------------------------------------------------
# Puppet Enterprise
# -----------------------------------------------------------------------------

puppet_instance_type = "r5.xlarge"
# puppet_ami_id      = ""  # Leave unset to auto-discover latest Amazon Linux 2023
