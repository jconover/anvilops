# =============================================================================
# AnvilOps Platform — Production Environment (~$1,740/month)
# =============================================================================
# Full high-availability configuration with Multi-AZ, WAF, deletion
# protection, and appropriately sized instances for production workloads.
#
# Usage:
#   cp terraform.production.tfvars.example terraform.production.tfvars
#   # Edit terraform.production.tfvars with your values
#   terraform plan -var-file terraform.production.tfvars -out tfplan
#   terraform apply tfplan
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

project_name     = "anvilops"
environment      = "production"
aws_region       = "us-east-1"
secondary_region = "us-west-2"

tags = {
  Team        = "Platform Engineering"
  CostCenter  = "INFRA-001"
  Environment = "production"
}

# -----------------------------------------------------------------------------
# DNS — Set your domain and optionally reuse an existing Route 53 hosted zone
# -----------------------------------------------------------------------------

domain_name              = "anvilops.example.com"
existing_route53_zone_id = ""  # e.g., "Z0123456789ABCDEFGHIJ"

# -----------------------------------------------------------------------------
# Networking — One NAT Gateway per AZ for full redundancy
# -----------------------------------------------------------------------------

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
single_nat_gateway = false

# -----------------------------------------------------------------------------
# EKS Cluster — Larger nodes, higher count for production workloads
# -----------------------------------------------------------------------------

eks_node_instance_types = ["t3.xlarge"]
eks_node_min_size       = 3
eks_node_max_size       = 10
eks_node_desired_size   = 4

# -----------------------------------------------------------------------------
# RDS PostgreSQL — Multi-AZ enabled by the module when env=production
# -----------------------------------------------------------------------------

db_instance_class    = "db.r6g.large"
db_allocated_storage = 100
db_name              = "anvilops"

# -----------------------------------------------------------------------------
# ElastiCache Redis — 2-node replication group with automatic failover
# -----------------------------------------------------------------------------

redis_node_type          = "cache.r6g.large"
redis_num_cache_clusters = 2

# -----------------------------------------------------------------------------
# Cognito
# -----------------------------------------------------------------------------

cognito_callback_urls = [
  "https://anvilops.example.com/api/auth/callback"
]

cognito_logout_urls = [
  "https://anvilops.example.com"
]

# -----------------------------------------------------------------------------
# Security — WAF enabled, deletion protection on
# -----------------------------------------------------------------------------

enable_waf                 = true
enable_deletion_protection = true

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

alert_email = "platform-team@example.com"

# -----------------------------------------------------------------------------
# Puppet Enterprise — Full-size instance for production compliance
# -----------------------------------------------------------------------------

puppet_instance_type = "r5.xlarge"
puppet_ami_id        = "ami-0123456789abcdef0"  # Replace with actual PE AMI
