# Database
DATABASE_URL=postgresql+asyncpg://anvilops:anvilops@db:5432/anvilops

# Redis
REDIS_URL=redis://redis:6379/0

# Terraform
TERRAFORM_WORK_DIR=/tmp/terraform

# AWS (for local dev, use AWS CLI profile or these)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWX (Ansible Tower)
AWX_BASE_URL=http://awx:8052
AWX_USERNAME=admin
AWX_PASSWORD=password
AWX_VERIFY_SSL=false
AWX_JOB_TIMEOUT=600
AWX_POLL_INTERVAL=10
AWX_ORGANIZATION_ID=1

# Puppet Enterprise
PUPPET_BASE_URL=https://puppet:8140
PUPPET_API_TOKEN=
PUPPET_VERIFY_SSL=false
PUPPET_CA_PORT=8140
PUPPET_CLASSIFIER_PORT=4433
PUPPET_PUPPETDB_PORT=8081
PUPPET_ORCHESTRATOR_PORT=8143
PUPPET_NODE_CHECKIN_TIMEOUT=600
PUPPET_NODE_CHECKIN_POLL=30
PUPPET_DEFAULT_ENVIRONMENT=production
PUPPET_CERTNAME_DOMAIN=anvilops.internal

# App
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=AnvilOps
