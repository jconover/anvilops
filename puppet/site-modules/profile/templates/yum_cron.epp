<%- | Boolean $auto_update_security,
      Boolean $auto_reboot,
| -%>
# AnvilOps Automated Patching Configuration - Managed by Puppet
# DO NOT EDIT THIS FILE MANUALLY - Changes will be overwritten

[commands]
# What kind of update to use:
# default                            = yum upgrade
# security                           = yum --security upgrade
# security-severity:Critical         = yum --sec-severity=Critical upgrade
# minimal                            = yum --bugfix update-minimal
# minimal-security                   = yum --security update-minimal
# minimal-security-severity:Critical = --sec-severity=Critical update-minimal
update_cmd = <%= $auto_update_security ? { true => 'security', false => 'default' } %>

# Whether a message should be emitted when updates are available,
# were downloaded, or applied.
update_messages = yes

# Whether updates should be downloaded when they are available.
download_updates = yes

# Whether updates should be applied when they are available.
# Note that download_updates must also be yes for the update to be applied.
apply_updates = <%= $auto_update_security ? { true => 'yes', false => 'no' } %>

# Maximum amount of time to randomly sleep, in minutes.
# The period 0 - random_sleep is randomly applied to each configured repo.
# This is useful for e.g. staggering the times when multiple systems will
# access update servers.
random_sleep = 360

[emitters]
# Name to use for this system in messages that are emitted.
system_name = None

# How to send messages. Valid options are stdio and email. If emit_via
# includes stdio, messages will be sent to stdout; this is useful to have
# cron send the messages. If emit_via includes email, this program will
# send email itself according to the configured options.
emit_via = stdio

# The width, in characters, that messages that are emitted should be
# formatted to.
output_width = 80

[email]
# The address to send email messages from.
email_from = root@localhost

# List of addresses to send messages to.
email_to = root

# Name of the host to connect to to send email messages.
email_host = localhost

[groups]
# NOTE: This only works when group_command != objects, which is now the default
# List of groups to update
group_list = None

# The types of group packages to install
group_package_types = mandatory, default

[base]
# This section overrides yum.conf

# Use this to filter Yum core messages
debuglevel = -2

# Skip broken packages during update
skip_broken = True

# AnvilOps: Auto-reboot configuration
# This is managed via a separate systemd timer or cron job
# <%= $auto_reboot ? { true => '# Auto-reboot enabled', false => '# Auto-reboot disabled' } %>
